---
// Übersichtsseite eines Bereichs, z. B. /vergleich. Listet alle Seiten mit Beschreibung.
import Base from './Base.astro';
import product from '../data/product.json';

interface Props {
  title: string;
  seoTitle: string;
  lede: string;
  description: string;
  path: string;
  items: { href: string; title: string; description: string }[];
}
const { title, seoTitle, lede, description, path, items } = Astro.props;
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Loqui', item: `${product.url}/` },
      { '@type': 'ListItem', position: 2, name: title, item: `${product.url}${path}` },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: title,
    url: `${product.url}${path}`,
    hasPart: items.map((i) => ({ '@type': 'WebPage', name: i.title, url: `${product.url}${i.href}` })),
  },
];
---
<Base title={`${seoTitle} – Loqui`} description={description} path={path} schema={schema}>
  <main class="page">
    <div class="wrap">
      <ol class="crumbs" aria-label="Brotkrumen"><li><a href="/">Loqui</a></li><li aria-current="page">{title}</li></ol>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="prose hub-intro"><slot /></div>
      <ul class="hub-list">
        {items.map((i) => <li><a href={i.href}><b>{i.title}</b><span>{i.description}</span></a></li>)}
      </ul>
    </div>
  </main>
</Base>
