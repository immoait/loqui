---
import Article from '../../layouts/Article.astro';
import { getCollection, render } from 'astro:content';
import { isLive } from '../../lib/live';

export async function getStaticPaths() {
  const entries = await getCollection('vergleich', isLive);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Article data={entry.data} hub={{ href: '/vergleich', label: 'Vergleiche' }} path={`/vergleich/${entry.id}`}>
  <div slot="top" class="table-wrap">
    <table>
      <thead><tr><td></td><th scope="col" class="you">Loqui</th><th scope="col">{entry.data.competitor}</th></tr></thead>
      <tbody>{entry.data.rows.map((r) => <tr><th scope="row">{r.label}</th><td data-label="Loqui">{r.loqui}</td><td data-label={entry.data.competitor}>{r.other}</td></tr>)}</tbody>
    </table>
  </div>
  <Content />
</Article>
