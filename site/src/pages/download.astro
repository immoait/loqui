---
// Download-Seite. Alle Buttons der Website führen hierher (/download?los).
// Auf dem Mac startet der Download mit ?los automatisch, auf anderen Geräten
// wird der Button zu „Link an mich schicken“. Datei-Adresse steht in product.json.
import Base from '../layouts/Base.astro';
import product from '../data/product.json';

const dl = product.download;
const ready = Boolean(dl.url);
const meta = [`macOS ${dl.minMacOS} oder neuer`, dl.version && `Version ${dl.version}`, dl.size].filter(Boolean).join(', ');

const faq = [
  { q: 'Kostet Loqui etwas?', a: 'Der Einstieg ist kostenlos, mit 5 Gesprächen im Monat. Pro mit unbegrenzten Gesprächen und eigener Wissensbasis kostet 19 € im Monat und lässt sich in der App freischalten.' },
  { q: 'Warum braucht Loqui Mikrofon und Systemaudio?', a: 'Über das Mikrofon hört Loqui dich, über das Systemaudio dein Gegenüber im Call. Beides zusammen ergibt das Gespräch, zu dem Loqui Vorschläge macht. Eine Bildschirmaufnahme braucht Loqui nicht.' },
  { q: 'Muss ich in Zoom oder Teams etwas installieren?', a: 'Nein. Loqui läuft als eigenes Fenster auf deinem Mac und tritt keinem Meeting bei.' },
  { q: 'Wie werde ich Loqui wieder los?', a: 'Loqui aus dem Programme-Ordner in den Papierkorb ziehen. Berichte liegen lokal und verschwinden mit der App.' },
];

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title="Loqui für Mac laden – Loqui" description={`Loqui kostenlos für den Mac laden: in drei Schritten installiert, ab macOS ${dl.minMacOS}. Läuft mit Zoom, Google Meet, Teams und Slack, ohne Bot im Meeting.`} path="/download" schema={schema}>
  <main class="page download">
    <div class="wrap">
      <h1>Loqui für den Mac.</h1>
      <p class="lede">Kostenlos laden und im nächsten Call ausprobieren.</p>

      <div class="dl-action" data-url={dl.url}>
        <p class="note" id="not-mac" hidden>Loqui läuft auf dem Mac. Schick dir den Link und lade die App dort.</p>
        {ready ? (
          <a class="btn big" id="dl-button" href={dl.url} download>Für Mac laden</a>
        ) : (
          <p class="dl-soon">Die erste Version ist fast fertig. Der Download erscheint hier in Kürze.</p>
        )}
        <button class="btn big" id="share-button" type="button" hidden>Link an mich schicken</button>
        <p class="note" id="dl-note">{meta}</p>
        <p class="note" id="dl-started" hidden aria-live="polite">Der Download läuft. Startet nichts? <a href={dl.url} download>Hier noch einmal laden</a>.</p>
      </div>

      <section class="steps" aria-labelledby="steps-title">
        <h2 id="steps-title">In drei Schritten startklar.</h2>
        <ol>
          <li>
            <b>Installieren</b>
            <span>Öffne die geladene Datei und ziehe Loqui in den Ordner Programme.</span>
          </li>
          <li>
            <b>Zuhören erlauben</b>
            <span>Starte Loqui. macOS fragt nach dem Mikrofon und nach „Nur Systemaudioaufnahme“. Erlaube beides, damit Loqui dich und dein Gegenüber hört.</span>
          </li>
          <li>
            <b>Call starten</b>
            <span>Starte ein Gespräch in Zoom, Google Meet, Teams oder Slack. Loqui erscheint oben am Bildschirm und hilft, sobald es zählt.</span>
          </li>
        </ol>
      </section>

      <section class="faq">
        <h2>Fragen zur Installation.</h2>
        <div class="list">
          {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </section>
    </div>
  </main>
</Base>

<script>
  const box = document.querySelector('.dl-action') as HTMLElement;
  const url = box.dataset.url;
  const ua = navigator.userAgent;
  // iPads melden sich als Mac, haben aber Touch.
  const isMac = /Macintosh|Mac OS X/.test(ua) && navigator.maxTouchPoints < 2;
  const show = (id: string, on: boolean) => { const el = document.getElementById(id); if (el) el.hidden = !on; };

  if (!isMac) {
    show('dl-button', false);
    show('share-button', true);
    show('not-mac', true);
    const share = document.getElementById('share-button') as HTMLButtonElement;
    share.addEventListener('click', async () => {
      const link = `${location.origin}/download`;
      try {
        if (navigator.share) await navigator.share({ title: 'Loqui für Mac', text: 'Loqui auf dem Mac laden:', url: link });
        else { await navigator.clipboard.writeText(link); share.textContent = 'Link kopiert'; }
      } catch { /* Teilen abgebrochen */ }
    });
  } else if (url && new URLSearchParams(location.search).has('los')) {
    // Download direkt starten, wenn jemand über einen Button kam.
    history.replaceState(null, '', '/download');
    setTimeout(() => { location.href = url; show('dl-started', true); }, 400);
  }
</script>
