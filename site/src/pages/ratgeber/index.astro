---
import Hub from '../../layouts/Hub.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../../lib/live';

const entries = (await getCollection('ratgeber', isLive)).sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
const items = entries.map((e) => ({ href: `/ratgeber/${e.id}`, title: e.data.title, description: e.data.description }));
---
<Hub title="Ratgeber" seoTitle="Ratgeber Verkaufsgespräch: Tipps für B2B-Vertrieb" lede="Wie gute Verkaufsgespräche funktionieren. Konkret, mit Vorlagen zum Mitnehmen." description="Ratgeber für bessere Verkaufsgespräche im B2B-Vertrieb: konkrete Techniken für Bedarfsanalyse, Fragen und Gesprächsführung, mit Beispielsätzen." path="/ratgeber" items={items}>
  <p>Hier geht es um das, was im Gespräch passiert: wie du fragst, zuhörst und das Gespräch lenkst. Jede Anleitung ist so geschrieben, dass du sie im nächsten Call ausprobieren kannst.</p>
</Hub>
