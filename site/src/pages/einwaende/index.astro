---
import Hub from '../../layouts/Hub.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../../lib/live';

const entries = (await getCollection('einwaende', isLive)).sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
const items = entries.map((e) => ({ href: `/einwaende/${e.id}`, title: e.data.title, description: e.data.description }));
---
<Hub title="Einwände" lede="Die häufigsten Einwände im B2B-Vertrieb, mit Antworten, die du direkt sagen kannst." description="Einwandbehandlung im B2B-Vertrieb: typische Einwände wie „zu teuer“ oder „kein Budget“ mit Antwortmustern, Beispielsätzen und Nachfragen." path="/einwaende" items={items} />
