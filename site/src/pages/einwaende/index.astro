---
import Hub from '../../layouts/Hub.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../../lib/live';

const entries = (await getCollection('einwaende', isLive)).sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
const items = entries.map((e) => ({ href: `/einwaende/${e.id}`, title: e.data.title, description: e.data.description }));
---
<Hub title="Einwände" seoTitle="Einwandbehandlung: Antworten auf Kundeneinwände" lede="Die häufigsten Einwände im B2B-Vertrieb, mit Antworten, die du direkt sagen kannst." description="Einwandbehandlung im B2B-Vertrieb: typische Kundeneinwände, was meistens dahintersteckt und Antworten mit Beispielsätzen, die du direkt sagen kannst." path="/einwaende" items={items}>
  <p>Ein Einwand ist selten ein Nein. Meist fehlt dem Kunden eine Information oder ein Bezug zwischen Preis und Nutzen. Jede Seite erklärt, was hinter dem Einwand steckt, und gibt dir Sätze, die du im Gespräch sagen kannst.</p>
</Hub>
