---
import Base from '../layouts/Base.astro';
import product from '../data/product.json';

const faq = [
  { q: 'Was unterscheidet Loqui von Granola?', a: 'Granola schreibt mit und fasst danach zusammen. Loqui hilft dir, während du sprichst.' },
  { q: 'Was unterscheidet Loqui von Cluely?', a: 'Cluely hilft live mit allgemeinem KI-Wissen. Loqui antwortet aus deiner eigenen Wissensbasis, mit Quelle, und coacht dich: Redeanteil live und Feedback nach jedem Gespräch.' },
  { q: 'Sieht mein Gegenüber die Vorschläge?', a: 'Nein. Loqui ist ein eigenes Fenster und erscheint nicht, wenn du deinen Bildschirm teilst.' },
  { q: 'Wohin geht das Gesagte?', a: 'Für Transkription und Vorschläge wird der Ton verschlüsselt an OpenAI geschickt. Loqui selbst speichert keine Aufnahmen. Berichte bleiben auf deinem Mac.' },
  { q: 'Lenkt das nicht ab?', a: 'Loqui zeigt höchstens einen Vorschlag auf einmal. Wie oft, stellst du ein.' },
  { q: 'Woher kennt Loqui unsere Preise?', a: 'Aus deiner Wissensbasis. Was dort nicht steht, erfindet Loqui nicht.' },
  { q: 'Was brauche ich?', a: `Einen Mac mit macOS ${product.download.minMacOS} oder neuer. Loqui funktioniert mit Zoom, Google Meet, Microsoft Teams und Slack, als App oder im Browser.` },
  { q: 'Gibt es Loqui für Windows?', a: 'Noch nicht. Wir starten mit dem Mac.' },
];

const schema = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${product.url}/#app`,
    name: product.name,
    url: `${product.url}/`,
    image: `${product.url}/og.png`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: product.platforms.join(', '),
    inLanguage: 'de',
    description: product.description,
    publisher: { '@id': `${product.url}/#org` },
    offers: product.plans.map((p) => ({
      '@type': 'Offer', name: p.name, price: String(p.price), priceCurrency: 'EUR', description: p.features.join(', '),
    })),
    softwareRequirements: `macOS ${product.download.minMacOS} oder neuer`,
    ...(product.download.url && { downloadUrl: product.download.url }),
    featureList: ['Echtzeit-Transkription', 'Antwortvorschläge aus eigener Wissensbasis', 'Nächste Frage', 'Redeanteil live', 'Feedback nach dem Gespräch'],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title="Loqui – KI-Gesprächscoach für Videocalls auf dem Mac" description="Loqui hört deine Videocalls in Zoom, Meet und Teams mit und zeigt dir in Echtzeit die passende Antwort, die nächste gute Frage und danach ehrliches Feedback." path="/" schema={schema}>
<header class="hero" id="top">
  <div class="wrap">
    <h1>Immer die <br>richtige Antwort.</h1>
    <p class="lede">Der Gesprächscoach, der live mithört und dir im richtigen Moment hilft.</p>
    <div class="actions">
      <a class="btn big" href="/download?los">Kostenlos für Mac laden</a>
      <a class="link" href="#funktionen">So funktioniert Loqui</a>
    </div>
    <p class="note">Ab macOS {product.download.minMacOS}. Läuft mit Zoom, Google&nbsp;Meet, Teams und&nbsp;Slack.</p>

    <div class="device">
      <div class="glow soft" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="screen" role="img" aria-label="Loqui über einem laufenden Videocall: Der Kunde sagt, es sei zu teuer. Zweieinhalb Sekunden später schlägt Loqui eine Antwort vor.">
        <div class="menubar"><b>Zoom</b><span>Mo 14:32</span></div>
        <div class="callwin">
          <div class="bar"><i></i><i></i><i></i></div>
          <div class="grid">
            <div class="person a"><div class="who"></div><span>Thomas Meyer</span></div>
            <div class="side">
              <div class="person b"><div class="who"></div><span>Du</span></div>
              <div class="person c"><div class="who"></div><span>Sandra Kühn</span></div>
            </div>
          </div>
        </div>
        <div class="pill dark-glass">
          <span class="rec"></span><time>12:41</time>
          <span class="meter"><i></i></span>
          <span class="prev"><span class="listen">Hört zu</span><span class="found">Preis-Einwand</span></span>
          <span class="stop"></span>
        </div>
        <p class="caption dark-glass"><b>Thomas Meyer</b>„Ehrlich gesagt ist uns das zu teuer.“</p>
        <div class="sheet dark-glass">
          <span class="kind">Antwort <span class="lat">nach {product.stats.suggestionSeconds} Sek.</span></span>
          <p class="say">„49 € pro Nutzer, und die doppelte Pflege in Excel fällt weg. Wie viele Stunden sind das bei Ihnen pro Woche?“</p>
          <p class="src">Aus: Preise, Case Meyer GmbH</p>
          <div class="chips">
            <span class="chip">Was soll ich sagen? <kbd>⌥␣</kbd></span>
            <span class="chip">Nächste Frage</span>
            <span class="chip">Einwand</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<section class="statement">
  <div class="wrap">
    <p><span>Loqui hört zu.</span> Und hilft genau dann, wenn es zählt.</p>
  </div>
</section>

<section id="funktionen" aria-labelledby="funktionen-titel">
  <div class="wrap">
    <h2 id="funktionen-titel" class="sr-only">Funktionen</h2>
    <div class="bento">
      <article class="tile t-answer">
        <div class="copy">
          <h3>Die Antwort, bevor die Pause zu lang wird.</h3>
          <p>Aus deiner Wissensbasis, mit Quelle. Was dort fehlt, erfindet Loqui nicht.</p>
        </div>
        <div class="say-card light-glass">
          <span class="kind">Antwort</span>
          <p class="say">„Unsere Server stehen in Frankfurt. Den AV&#8209;Vertrag schicke ich Ihnen heute noch.“</p>
          <p class="src">Aus: Datenschutz</p>
        </div>
      </article>

      <article class="tile t-question">
        <div class="copy">
          <h3>Die eine Frage, die fehlt.</h3>
        </div>
        <p class="bubble"><small>Nächste Frage</small>„Was passiert, wenn das bis Q2 nicht gelöst ist?“</p>
      </article>

      <article class="tile t-talk">
        <div class="copy">
          <h3>Redeanteil, live.</h3>
        </div>
        <div class="ring"><div><b>58 %</b><small>du</small></div></div>
      </article>

      <article class="tile t-report">
        <div class="copy">
          <h3>Ehrliches Feedback nach jedem Gespräch.</h3>
          <p>Was gut lief. Was du beim nächsten Mal anders machst.</p>
        </div>
        <div class="report">
          <time>12:41</time><div class="row"><span class="dot" style="background:var(--teal)"></span>Preis-Einwand sauber in Nutzen übersetzt.</div>
          <time>18:05</time><div class="row"><span class="dot" style="background:var(--apricot)"></span>Frage nach dem Zeitdruck fehlte.</div>
          <time>22:00</time><div class="row"><span class="dot" style="background:var(--violet)"></span>Zweieinhalb Minuten am Stück geredet.</div>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="about" id="was-ist-loqui">
  <div class="wrap">
    <div>
      <h2>Was Loqui ist.</h2>
      <p>Ein Gesprächscoach für den Mac. Er hört deine Videocalls in Zoom, Google&nbsp;Meet, Teams und Slack mit und zeigt dir die passende Antwort aus deinen Unterlagen, die nächste gute Frage oder einen Hinweis, wenn du zu lange redest. Danach bekommst du Feedback mit Zeitmarken.</p>
    </div>
    <div class="compare" aria-label="Loqui im Vergleich">
      <div><b>Granola</b><span>Schreibt mit und fasst danach zusammen.</span></div>
      <div><b>Fireflies</b><span>Nimmt auf, transkribiert, analysiert nach dem Gespräch.</span></div>
      <div><b>Cluely</b><span>Hilft live mit allgemeinem KI-Wissen.</span></div>
      <div class="you"><b>Loqui</b><span>Hilft live mit Antworten aus deinen Unterlagen. Und zeigt dir, wie du besser wirst.</span></div>
    </div>
  </div>
</section>

<section class="open" id="datenschutz">
  <div class="wrap">
    <div>
      <h2>Läuft still im Hintergrund.</h2>
      <p class="lede">Du merkst Loqui nur, wenn es dir hilft.</p>
    </div>
    <dl class="facts">
      <div><dt>Kein Bot im Meeting</dt><dd>Loqui läuft als Fenster auf deinem Mac und tritt keinem Call bei.</dd></div>
      <div><dt>Nur du siehst die Vorschläge</dt><dd>Auch nicht, wenn du deinen Bildschirm teilst.</dd></div>
      <div><dt>Keine Aufnahmen</dt><dd>Der Ton geht verschlüsselt zur Transkription an OpenAI. Loqui speichert ihn nicht.</dd></div>
      <div><dt>Berichte bleiben bei dir</dt><dd>Feedback und Verlauf liegen lokal auf deinem Mac.</dd></div>
    </dl>
  </div>
</section>

<section class="pricing" id="preise">
  <div class="wrap">
    <div class="center">
      <h2>Einfach anfangen.</h2>
    </div>
    <div class="plans">
      {product.plans.map((p, i) => (
        <div class={i === 1 ? 'plan pro' : 'plan'}>
          <span class="name">{p.name}</span>
          <span class="price">{p.price} €{p.period && <small> im {p.period}</small>}</span>
          <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          <a class={i === 1 ? 'btn' : 'btn light'} href="/download?los">{i === 1 ? 'Laden und in der App upgraden' : 'Kostenlos laden'}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq" id="fragen">
  <div class="wrap">
    <div class="center"><h2>Fragen.</h2></div>
    <div class="list">
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </div>
</section>

<section class="closing">
  <div class="wrap">
    <div class="finale">
      <h2>Dein bestes Gespräch<br>kommt noch.</h2>
      <a class="btn" href="/download?los">Kostenlos für Mac laden</a>
    </div>
  </div>
</section>

</Base>
